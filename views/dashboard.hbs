<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Global Platform Metrics</h1>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
    <div class="col">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title text-muted">Registered Users</h5>
                <h2 class="card-text text-primary fw-bold">{{UserCount}}</h2>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title text-muted">Vehicles Recorded</h5>
                <h2 class="card-text text-primary fw-bold">{{VehicleCount}}</h2>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title text-muted">Total Revenue</h5>
                <h2 class="card-text text-success fw-bold">Rp {{TotalRevenue}}</h2>
            </div>
        </div>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-2 g-4">
    <div class="col">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title text-muted">Total Transactions</h5>
                <h2 class="card-text text-info fw-bold">{{TotalTx}}</h2>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title text-muted">Pending Payment</h5>
                <h2 class="card-text text-warning fw-bold">{{PendingTx}}</h2>
            </div>
        </div>
    </div>
</div>
