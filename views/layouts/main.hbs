<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Parkieee Back-Office</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --gf-bg: #111217;
            --gf-panel-bg: #181b1f;
            --gf-border: #2c3235;
            --gf-text: #ccccdc;
            --gf-text-title: #ffffff;
            --gf-primary: #3274D9;
            --gf-orange: #FF780A;
            --gf-green: #73BF69;
            --gf-red: #F2495C;
            --gf-sidebar: #0b0c0e;
        }
        body { 
            padding-top: 56px; 
            background-color: var(--gf-bg); 
            color: var(--gf-text);
            font-family: 'Inter', sans-serif;
            font-size: 14px;
        }
        .navbar {
            background-color: var(--gf-sidebar) !important;
            border-bottom: 1px solid var(--gf-border);
        }
        .navbar-brand {
            color: var(--gf-orange) !important;
            font-weight: 700;
        }
        .sidebar {
            position: fixed;
            top: 56px;
            bottom: 0;
            left: 0;
            z-index: 100;
            padding: 24px 0 0; 
            background-color: var(--gf-sidebar) !important;
            border-right: 1px solid var(--gf-border);
            width: 200px;
        }
        .nav-link {
            color: #9fa6b2;
            font-weight: 500;
            padding: 8px 24px;
        }
        .nav-link:hover {
            color: var(--gf-text-title);
            background: #22252b;
            border-left: 3px solid var(--gf-orange);
        }
        .card {
            background-color: var(--gf-panel-bg);
            border: 1px solid var(--gf-border);
            border-radius: 4px;
            box-shadow: none !important;
            color: var(--gf-text);
        }
        .card-header {
            background-color: var(--gf-panel-bg);
            border-bottom: none;
            color: var(--gf-text-title);
            font-weight: 600;
            padding-bottom: 0;
        }
        .card-body {
            padding: 1.25rem;
        }
        .table {
            color: var(--gf-text);
            font-size: 13px;
        }
        .table>:not(caption)>*>* {
            background-color: var(--gf-panel-bg);
            border-bottom-color: var(--gf-border);
            padding: 12px 16px;
        }
        .table-dark {
            --bs-table-bg: #1e2228;
            --bs-table-border-color: var(--gf-border);
        }
        .table-dark th {
            color: #8e99a8;
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
        }
        .badge { font-weight: 500; font-family: monospace; }
        .bg-success { background-color: var(--gf-green) !important; }
        .bg-danger { background-color: var(--gf-red) !important; }
        .bg-primary { background-color: var(--gf-primary) !important; }
        h1, h2, h3, h4, h5, h6 { color: var(--gf-text-title); font-weight: 600; }
        main { margin-left: 200px; }
        .border-bottom { border-bottom-color: var(--gf-border) !important; }
        .text-primary { color: var(--gf-primary) !important; }
        .text-success { color: var(--gf-green) !important; }
        .text-warning { color: var(--gf-orange) !important; }
    </style>
</head>
<body>
    <header class="navbar navbar-dark fixed-top bg-dark flex-md-nowrap p-0 shadow">
        <a class="navbar-brand col-md-3 col-lg-2 me-0 px-3 py-3 fs-6 text-uppercase" href="/ui/dashboard">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2 text-warning"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.4-1.7-1-2.2l-3.2-2.1A2 2 0 0 0 16.7 8H7.3a2 2 0 0 0-1.1.7L3 10.8C2.4 11.3 2 12.1 2 13v3c0 .6.4 1 1 1h2"/><rect width="4" height="4" x="4" y="17" rx="2"/><rect width="4" height="4" x="16" y="17" rx="2"/><path d="M4 13h16"/></svg>
            Parkieee Admin
        </a>
    </header>

    <div class="container-fluid">
        <div class="row">
            <nav id="sidebarMenu" class="sidebar">
                <div class="sidebar-sticky mt-3">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="/ui/dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/ui/transactions">Transactions</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/ui/vehicles">Vehicles</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/ui/zones">Zones & Gates</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/ui/fees">Fee Configs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/ui/users">Users</a>
                        </li>
                    </ul>
                </div>
            </nav>

            <main class="col px-md-4 pt-4 pb-4">
                {{{embed}}}
            </main>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
