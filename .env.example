# =========================
# App server
# =========================
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173
LOG_LEVEL=info
LOG_FORMAT=text

# =========================
# Database
# =========================
# Local run
DATABASE_URL=postgres://postgres:postgres@localhost:5432/parkieee?sslmode=disable

# Docker compose helpers
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=parkieee
POSTGRES_PORT=5432

# =========================
# Auth / security
# =========================
JWT_SECRET=replace-with-strong-secret
JWT_EXP_MINUTES=15
GATE_JWT_SECRET=replace-with-strong-gate-secret

COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict
USE_CSRF=true

TENANT_ID=00000000-0000-0000-0000-000000000001

# =========================
# Object storage (S3-compatible)
# =========================
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=parkieee
S3_ACCESS_KEY=replace-with-access-key
S3_SECRET_KEY=replace-with-secret-key
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:9000/parkieee

# =========================
# Midtrans
# =========================
MIDTRANS_SERVER_KEY=replace-with-midtrans-server-key
MIDTRANS_CLIENT_KEY=replace-with-midtrans-client-key
MIDTRANS_ENV=sandbox

# =========================
# OCR / LPR
# =========================
LPR_SERVICE_URL=http://localhost:8001

# =========================
# Telegram bot (optional)
# =========================
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# =========================
# Cloudflared (required if running cloudflared service)
# =========================
CLOUDFLARED_TUNNEL_TOKEN=
